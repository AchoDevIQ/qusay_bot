{
  "name": "qmath-bot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "set-webhook": "node --env-file-if-exists=.env.local scripts/set-webhook.ts",
    "firebase-check": "node --env-file-if-exists=.env.local scripts/firebase-check.ts",
    "upload-content": "node --env-file-if-exists=.env.local scripts/upload-content.ts",
    "copy-to-firestore": "node --env-file-if-exists=.env.local scripts/copy-to-firestore.ts",
    "upload-answers": "node scripts/upload-answers.ts",
    "test": "node --test tests/*.test.ts",
    "load-exams": "node --env-file-if-exists=.env.local scripts/load-exams.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@sparticuz/chromium": "^153.0.0",
    "firebase-admin": "^14.5.0",
    "jsqr": "^1.4.0",
    "next": "^15",
    "pdfjs-dist": "^6.5.438",
    "puppeteer-core": "^25.16.0",
    "qrcode": "^1.5.4",
    "react": "^19",
    "react-dom": "^19"
  },
  "overrides": {
    "postcss": "^8.5.10"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "typescript": "^5"
  }
}
