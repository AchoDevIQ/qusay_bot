<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- أندرويد 11 وفوك: لازم نعلن خدمة طابعة SUNMI حتى نشوفها -->
    <queries>
        <package android:name="woyou.aidlservice.jiuiv5" />
    </queries>
    <application
        android:label="ليبل QMath"
        android:icon="@android:drawable/ic_menu_send"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.NoActionBar">
        <activity android:name=".MainActivity" android:exported="true" android:screenOrientation="portrait" android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- رابط المحطة من صفحة الحضوري ينفتح بالتطبيق مباشرة -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="qusay-bot--qmath-v2.europe-west4.hosted.app" android:pathPrefix="/store/station" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>
    </application>
</manifest>
