# انسخ هذا الملف إلى .env.local وعبّي القيم (لا ترفعه على GitHub)
TOKEN=PUT_BOT_TOKEN_HERE
ADMIN=123456789
STORE_URL=https://your-domain.com
WEBHOOK_SECRET=PUT_LONG_RANDOM_TEXT_HERE
DB_PATH=./data/store.db
# Firebase. إذا FIREBASE_PROJECT_ID فارغ، البوت يشتغل على SQLite
# المفتاح الخاص يلزم بس للتشغيل من الحاسبة: Project settings > Service accounts > Generate new private key
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nPUT_KEY_HERE\n-----END PRIVATE KEY-----\n"
FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
